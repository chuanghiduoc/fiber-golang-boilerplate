// Package handler is the {{.M.Name}} HTTP adapter: it binds and
// validates requests, calls a service use case, and maps service types to
// dto/ responses. It must not import repository/, sqlc, or pgx.
package handler

import (
	"context"

	"{{.M.ModulePath}}/internal/platform/httpapi"
)

// HealthUseCase is the service surface HealthHandler needs.
type HealthUseCase interface {
	Check(ctx context.Context) error
}

// HealthResponse is the module health document.
type HealthResponse struct {
	Module string `json:"module"`
	Status string `json:"status"`
}

// HealthHandler serves the module health route.
type HealthHandler struct {
	service HealthUseCase
}

// NewHealthHandler returns a HealthHandler over service.
func NewHealthHandler(service HealthUseCase) *HealthHandler {
	return &HealthHandler{service: service}
}

// Health checks that the module can reach its database.
func (h *HealthHandler) Health(ctx context.Context) (*httpapi.Output[HealthResponse], error) {
	if err := h.service.Check(ctx); err != nil {
		return nil, err
	}
	return &httpapi.Output[HealthResponse]{Body: HealthResponse{Module: "{{.M.Name}}", Status: "ok"}}, nil
}
