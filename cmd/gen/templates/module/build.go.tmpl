// Settings is the configuration {{.M.Name}} owns. The composition root
// (internal/bootstrap) fills it from config, so the module never reads another
// module's section. Add fields when the module needs configuration.
type Settings struct{}

// Provides lists the internal/contracts values {{.M.Name}} supplies to modules
// built after it in internal/bootstrap. Add fields when another module needs
// this module's capability.
type Provides struct{}

// Deps are the contracts {{.M.Name}} consumes from modules built before it.
// Add fields when this module needs another module's internal/contracts value.
type Deps struct{}

// Build constructs the repositories, services, and handlers from the shared
// infrastructure. It performs no I/O. Another module's capability arrives only
// through Deps, wired in internal/bootstrap/modules.go. The error result is for
// construction that can fail (for example parsing a key from settings).
func Build(infra app.Infra, _ Settings, _ Deps) (*Module, error) {
	authorizer := authz.NewAuthorizer(infra.Catalogs.Permissions)
	handlers := Handlers{
		Health: {{.M.Ident}}handler.NewHealthHandler({{.M.Ident}}service.NewHealthService({{.M.Ident}}repository.NewHealthRepository(infra.DB), authorizer)),
		// gen:build
	}
	m := New(handlers)
	// gen:purge
	return m, nil
}