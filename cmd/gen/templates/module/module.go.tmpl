// Package {{.M.Name}} owns the {{.M.Name}} business capability.
//
// Layout: service/
// holds the use cases and the ports they need (service/ports.go),
// repository/ implements those ports with sqlc, handler/ and dto/ are the
// HTTP adapter, and catalog/ holds the public identifiers (permissions, error
// codes, locales). cmd/gen inserts new slices above the "gen:" marker
// comments; keep them.
package {{.M.Name}}

import (
	"context"
	"io/fs"
	"net/http"

	"{{.M.ModulePath}}/internal/app"
	tenancycontracts "{{.M.ModulePath}}/internal/contracts/tenancy"
	{{.M.Ident}}catalog "{{.M.ModulePath}}/internal/modules/{{.M.Name}}/catalog"
	{{.M.Ident}}handler "{{.M.ModulePath}}/internal/modules/{{.M.Name}}/handler"
	"{{.M.ModulePath}}/internal/platform/authz"
	"{{.M.ModulePath}}/internal/platform/httpapi"
	"{{.M.ModulePath}}/pkg/apperror"
)

// Handlers are the module's HTTP adapters. Build fills every field; tests
// may build handlers over fakes and pass them to New.
type Handlers struct {
	Health *{{.M.Ident}}handler.HealthHandler
	// gen:handlers
}

// Module wires the {{.M.Name}} HTTP surface into the application.
type Module struct {
	handlers Handlers
	// tenantPurgers erase each generated resource's rows when a deleted tenant
	// is purged. cmd/gen appends one per resource; TenantPurgers exposes
	// them through the internal/contracts/tenancy registry.
	tenantPurgers []tenancycontracts.Purger
}

var _ app.RouteProvider = (*Module)(nil)

// New builds the module from its handlers. Production code uses Build.
func New(handlers Handlers) *Module {
	return &Module{handlers: handlers}
}

// Name identifies the module in the registry and owns its catalog entries.
func (m *Module) Name() string { return {{.M.Ident}}catalog.Owner }

// Permissions implements app.PermissionProvider.
func (m *Module) Permissions() []authz.Grant { return {{.M.Ident}}catalog.Permissions() }

// Errors implements app.ErrorProvider.
func (m *Module) Errors() []apperror.Spec { return {{.M.Ident}}catalog.Errors() }

// Locales implements app.LocaleProvider.
func (m *Module) Locales() fs.FS { return {{.M.Ident}}catalog.Locales() }

// RegisterRoutes implements app.RouteProvider. Operations carry their whole
// policy (permission, rate tier, idempotency, audit) in the declaration; the
// shared middleware chain enforces the order test/arch checks.
func (m *Module) RegisterRoutes(api *httpapi.API, deps app.Deps) {
	httpapi.Register(api, httpapi.Op{
		Method:      http.MethodGet,
		Path:        "/api/v1/{{.M.Route}}/health",
		OperationID: "{{.M.Ident}}Health",
		Tags:        []string{"{{.M.Route}}"},
		Summary:     "{{.M.Name}} module health",
		Description: "Checks that the {{.M.Name}} module can reach its database.",
	}, httpapi.Policy{
		Permission: {{.M.Ident}}catalog.PermissionRead,
		RateLimit:  httpapi.RateLimitRelaxed,
	}, func(ctx context.Context, _ *struct{}) (*httpapi.Output[{{.M.Ident}}handler.HealthResponse], error) {
		return m.handlers.Health.Health(ctx)
	})
	// gen:routes
}
