package service

import (
	"context"
	"errors"
	"fmt"
	"os"
	"testing"

	"github.com/google/uuid"

	{{.M.Ident}}catalog "{{.M.ModulePath}}/internal/modules/{{.M.Name}}/catalog"
	"{{.M.ModulePath}}/internal/platform/authz"
	"{{.M.ModulePath}}/internal/platform/tenant"
	"{{.M.ModulePath}}/pkg/apperror"
)

var (
	// testTenant is the seeded default tenant; otherTenant is a second tenant
	// used to prove isolation.
	testTenant  = tenant.DefaultID
	otherTenant = uuid.MustParse("0192c9b0-7e4a-7000-8000-000000000002")
	testUserID  = uuid.MustParse("0192c9b0-7e4a-7000-8000-0000000000c1")
)

// TestMain registers the module catalog: these tests do not build the app,
// and unregistered permissions or error codes would fail closed.
func TestMain(m *testing.M) {
	if err := {{.M.Ident}}catalog.Register(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	os.Exit(m.Run())
}

// adminContext is a request context for an administrator of tenantID.
func adminContext(tenantID uuid.UUID) context.Context {
	ctx := tenant.WithID(context.Background(), tenantID)
	permissions := make([]authz.Permission, 0, len({{.M.Ident}}catalog.Permissions()))
	for _, grant := range {{.M.Ident}}catalog.Permissions() {
		permissions = append(permissions, grant.Permission)
	}
	return authz.WithSubject(ctx, authz.NewSubjectWithPermissions(testUserID, tenantID, authz.RoleAdmin, permissions...))
}

// userContext is a request context for a plain user of tenantID.
func userContext(tenantID uuid.UUID) context.Context {
	ctx := tenant.WithID(context.Background(), tenantID)
	return authz.WithSubject(ctx, authz.NewSubject(uuid.MustParse("0192c9b0-7e4a-7000-8000-0000000000c2"), tenantID, authz.RoleMember))
}

// requireCode fails unless err is an *apperror.AppError with code want.
func requireCode(t *testing.T, err error, want apperror.Code) {
	t.Helper()
	var appErr *apperror.AppError
	if !errors.As(err, &appErr) || appErr.Code != string(want) {
		t.Fatalf("error = %v, want code %s", err, want)
	}
}
