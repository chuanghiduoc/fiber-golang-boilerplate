package handler

import (
	"context"
	"errors"
	"testing"
)

type fakeHealthUseCase struct{ err error }

func (f fakeHealthUseCase) Check(context.Context) error { return f.err }

func TestHealthHandler(t *testing.T) {
	out, err := NewHealthHandler(fakeHealthUseCase{}).Health(context.Background())
	if err != nil {
		t.Fatalf("Health = %v, want nil", err)
	}
	if out.Body.Status != "ok" || out.Body.Module != "{{.M.Name}}" {
		t.Fatalf("Health = %#v, want ok for {{.M.Name}}", out.Body)
	}

	down := errors.New("down")
	if _, err := NewHealthHandler(fakeHealthUseCase{err: down}).Health(context.Background()); !errors.Is(err, down) {
		t.Fatalf("Health with a failing check = %v, want the wrapped error", err)
	}
}
