package handler

import (
	"context"
	"errors"
	"net/http"
	"strings"
	"testing"
)

type fakeHealthUseCase struct{ err error }

func (f fakeHealthUseCase) Check(context.Context) error { return f.err }

func TestHealthHandler(t *testing.T) {
	app := newTestApp()
	app.Get("/health", NewHealthHandler(fakeHealthUseCase{}).Health)
	status, body := do(t, app, http.MethodGet, "/health", "")
	if status != http.StatusOK || !strings.Contains(body, `"status":"ok"`) {
		t.Fatalf("GET /health = %d %s, want 200 ok", status, body)
	}

	failing := newTestApp()
	failing.Get("/health", NewHealthHandler(fakeHealthUseCase{err: errors.New("down")}).Health)
	if status, body := do(t, failing, http.MethodGet, "/health", ""); status != http.StatusInternalServerError {
		t.Fatalf("GET /health with a failing check = %d %s, want 500", status, body)
	}
}
