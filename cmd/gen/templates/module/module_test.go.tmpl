const testJWTSecret = "{{.M.Name}}-module-test-secret"

func testConfig() *config.Config {
	return &config.Config{
		App:       config.AppConfig{Env: "production", BodyLimit: 1 << 20, RequestTimeout: 5},
		JWT:       config.JWTConfig{Secret: testJWTSecret},
		CORS:      config.CORSConfig{AllowOrigins: "*"},
		RateLimit: config.RateLimitConfig{StrictMax: 5, StrictWindow: 60, NormalMax: 600, NormalWindow: 60, RelaxedMax: 600, RelaxedWindow: 60},
		Tenant:    config.TenantConfig{DefaultSlug: "default"},
	}
}

// testApp builds the full middleware stack around a module built with deps.
func testApp(t *testing.T, infra app.Infra, deps app.Deps) *fiber.App {
	t.Helper()
	m, _, err := Build(infra, Settings{})
	if err != nil {
		t.Fatalf("Build: %v", err)
	}
	if deps.Cache == nil {
		deps.Cache = cache.NewMemoryCache()
	}
	if deps.Sessions == nil {
		deps.Sessions = sessiontest.AllowAll()
	}
	application := app.New(testConfig(), deps)
	application.Register(m)
	return application.Fiber()
}

// bearer mints an access token for userID with role in tenantID.
func bearer(t *testing.T, userID, tenantID uuid.UUID, role string) string {
	t.Helper()
	tok, err := token.GenerateForSession(token.SessionClaims{
		UserID: userID, TenantID: tenantID, SessionID: uuid.New(), TokenVersion: 1,
	}, testJWTSecret, time.Hour)
	if err != nil {
		t.Fatalf("token: %v", err)
	}
	return "Bearer " + tok
}

// do sends one JSON request (body may be empty) and returns status and body.
func do(t *testing.T, fiberApp *fiber.App, method, target, authorization, body string) (status int, payload string) {
	t.Helper()
	var reader io.Reader = http.NoBody
	if body != "" {
		reader = strings.NewReader(body)
	}
	req := httptest.NewRequest(method, target, reader)
	if body != "" {
		contentType := fiber.MIMEApplicationJSON
		if method == http.MethodPatch {
			contentType = "application/merge-patch+json"
		}
		req.Header.Set(fiber.HeaderContentType, contentType)
	}
	if authorization != "" {
		req.Header.Set(fiber.HeaderAuthorization, authorization)
	}
	resp, err := fiberApp.Test(req)
	if err != nil {
		t.Fatalf("%s %s: %v", method, target, err)
	}
	defer func() { _ = resp.Body.Close() }()
	raw, err := io.ReadAll(resp.Body)
	if err != nil {
		t.Fatalf("read body: %v", err)
	}
	return resp.StatusCode, string(raw)
}

func TestCatalogRegistersAndLocalizes(t *testing.T) {
	m, _, err := Build(app.Infra{}, Settings{})
	if err != nil {
		t.Fatalf("Build: %v", err)
	}
	if m.Name() != {{.M.Ident}}catalog.Owner {
		t.Fatalf("Name() = %q, want %q", m.Name(), {{.M.Ident}}catalog.Owner)
	}
	catalogs, err := app.BuildCatalogs(m)
	if err != nil {
		t.Fatalf("BuildCatalogs: %v", err)
	}
	for _, grant := range {{.M.Ident}}catalog.Permissions() {
		if !catalogs.Permissions.IsKnownPermission(grant.Permission) {
			t.Errorf("%s is not registered", grant.Permission)
		}
	}
	bundle, err := i18n.New("en", app.LocaleSources(m)...)
	if err != nil {
		t.Fatalf("locales: %v", err)
	}
	for _, spec := range {{.M.Ident}}catalog.Errors() {
		if _, ok := catalogs.Errors.SpecFor(spec.Code); !ok {
			t.Errorf("%s is not registered", spec.Code)
		}
		for _, locale := range bundle.SupportedLocales() {
			if key := "errors." + string(spec.Code) + ".title"; !bundle.Has(locale, key) {
				t.Errorf("%s is missing %q", locale, key)
			}
		}
	}
}

// TestHealthRequiresAuthentication proves the generated operation is on the
// authenticated huma path, not a bare Fiber route.
func TestHealthRequiresAuthentication(t *testing.T) {
	fiberApp := testApp(t, app.Infra{}, app.Deps{})
	status, body := do(t, fiberApp, http.MethodGet, "/api/v1/{{.M.Route}}/health", "", "")
	if status != http.StatusUnauthorized {
		t.Errorf("GET health without a token = %d %s, want 401", status, body)
	}
}

func TestHealthRequiresPermission(t *testing.T) {
	fiberApp := testApp(t, app.Infra{}, app.Deps{})
	status, body := do(t, fiberApp, http.MethodGet, "/api/v1/{{.M.Route}}/health", bearer(t, uuid.MustParse("0192c9b0-7e4a-7000-8000-0000000000d1"), tenant.DefaultID, authz.RoleMember), "")
	if status != http.StatusForbidden {
		t.Fatalf("GET health as a user = %d %s, want 403 ({{.M.Name}}:read is admin-only)", status, body)
	}
}
