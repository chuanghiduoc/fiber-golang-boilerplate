package service

import (
	"context"
	"fmt"

	{{.M.Ident}}catalog "{{.M.ModulePath}}/internal/modules/{{.M.Name}}/catalog"
	"{{.M.ModulePath}}/internal/platform/authz"
)

// HealthService checks the module's dependencies.
type HealthService struct {
	checker    HealthChecker
	authorizer authz.Authorizer
}

// NewHealthService returns a HealthService over checker.
func NewHealthService(checker HealthChecker, authorizer authz.Authorizer) *HealthService {
	return &HealthService{checker: checker, authorizer: authorizer}
}

// Check returns nil when the module's database answers.
func (s *HealthService) Check(ctx context.Context) error {
	if err := authorize(ctx, s.authorizer, {{.M.Ident}}catalog.PermissionRead); err != nil {
		return err
	}
	if err := s.checker.Ping(ctx); err != nil {
		return fmt.Errorf("{{.M.Name}}: ping database: %w", err)
	}
	return nil
}