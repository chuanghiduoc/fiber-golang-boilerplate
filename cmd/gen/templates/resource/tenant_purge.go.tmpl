package repository

import (
	"context"
	"fmt"

	"github.com/google/uuid"

	tenancycontracts "{{.M.ModulePath}}/internal/contracts/tenancy"
	{{.M.Ident}}sqlc "{{.M.ModulePath}}/internal/modules/{{.M.Name}}/sqlc"
	"{{.M.ModulePath}}/internal/platform/tenant"
)

// {{.R.Pascal}}TenantPurger implements tenancy.Purger for {{.R.Table}}. It is
// the only {{.R.Human}} query that removes rows by tenant rather than by the
// request tenant; identity's purge job calls it after the per-user erasers.
type {{.R.Pascal}}TenantPurger struct {
	q *{{.M.Ident}}sqlc.Queries
}

var _ tenancycontracts.Purger = (*{{.R.Pascal}}TenantPurger)(nil)

// New{{.R.Pascal}}TenantPurger binds the tenant-wide purger to db (the
// RLS-scoped handle).
func New{{.R.Pascal}}TenantPurger(db {{.M.Ident}}sqlc.DBTX) *{{.R.Pascal}}TenantPurger {
	return &{{.R.Pascal}}TenantPurger{q: {{.M.Ident}}sqlc.New(db)}
}

// PurgeTenant deletes one bounded page at a time until none remain. Re-running
// after a partial failure is safe: deleted pages are gone and the rest is
// selected again.
func (p *{{.R.Pascal}}TenantPurger) PurgeTenant(ctx context.Context, tenantID uuid.UUID) error {
	ctx = tenant.WithID(ctx, tenantID)
	for {
		deleted, err := p.q.DeleteTenant{{.R.Pascal}}Batch(ctx, {{.M.Ident}}sqlc.DeleteTenant{{.R.Pascal}}BatchParams{
			TenantID:  tenantID,
			BatchSize: tenancycontracts.PurgeBatchSize,
		})
		if err != nil {
			return fmt.Errorf("delete tenant {{.R.Table}}: %w", err)
		}
		if deleted == 0 {
			return nil
		}
	}
}
