// List{{.R.PluralPascal}} returns up to cursor.Limit {{.R.HumanPlural}} older than the
// cursor, newest first.
func (r *{{.R.Pascal}}Repository) List{{.R.PluralPascal}}(ctx context.Context, cursor pagination.DBCursor) ([]{{.M.Ident}}service.{{.R.Pascal}}, error) {
	rows, err := r.q.List{{.R.PluralPascal}}(ctx, {{.M.Ident}}sqlc.List{{.R.PluralPascal}}Params{
		TenantID:        tenant.EffectiveID(ctx),
		CursorCreatedAt: cursor.CreatedAtParam(),
		CursorID:        cursor.IDParam(),
		RowLimit:        cursor.Limit,
	})
	if err != nil {
		return nil, fmt.Errorf("list {{.R.Table}}: %w", err)
	}
	out := make([]{{.M.Ident}}service.{{.R.Pascal}}, len(rows))
	for i, row := range rows {
		out[i] = to{{.R.Pascal}}(row)
	}
	return out, nil
}

// Patch{{.R.Pascal}} changes only the fields the caller supplied; an omitted
// field stays as it is.
func (r *{{.R.Pascal}}Repository) Patch{{.R.Pascal}}(ctx context.Context, id int64, in {{.M.Ident}}service.{{.R.Pascal}}Patch) ({{.M.Ident}}service.{{.R.Pascal}}, error) {
	params := {{.M.Ident}}sqlc.Patch{{.R.Pascal}}Params{
		TenantID: tenant.EffectiveID(ctx),
		ID:       id,
	}
	if in.Name != nil {
		params.SetName, params.Name = true, *in.Name
	}
	row, err := r.q.Patch{{.R.Pascal}}(ctx, params)
	if err != nil {
		return {{.M.Ident}}service.{{.R.Pascal}}{}, noRows(err, "patch {{.R.Table}}")
	}
	return to{{.R.Pascal}}(row), nil
}

// Delete{{.R.Pascal}} removes one {{.R.Human}}; deleting nothing is not found.
func (r *{{.R.Pascal}}Repository) Delete{{.R.Pascal}}(ctx context.Context, id int64) error {
	affected, err := r.q.Delete{{.R.Pascal}}(ctx, {{.M.Ident}}sqlc.Delete{{.R.Pascal}}Params{
		TenantID: tenant.EffectiveID(ctx),
		ID:       id,
	})
	if err != nil {
		return fmt.Errorf("delete {{.R.Table}}: %w", err)
	}
	if affected == 0 {
		return apperror.ErrNotFound
	}
	return nil
}

func to{{.R.Pascal}}(row {{.M.Ident}}sqlc.{{.R.Model}}) {{.M.Ident}}service.{{.R.Pascal}} {
	return {{.M.Ident}}service.{{.R.Pascal}}{
		ID:        row.ID,
		TenantID:  row.TenantID,
		Name:      row.Name,
		CreatedAt: row.CreatedAt.Time,
		UpdatedAt: row.UpdatedAt.Time,
	}
}
