	var row {{.M.Ident}}sqlc.{{.R.Model}}
	if expected != nil {
		row, err = r.q.Patch{{.R.Pascal}}IfUnchanged(ctx, {{.M.Ident}}sqlc.Patch{{.R.Pascal}}IfUnchangedParams{
			TenantID:          tenantID,
			ID:                id,
			SetName:           params.SetName,
			Name:              params.Name,
			ExpectedUpdatedAt: pgtype.Timestamptz{Time: *expected, Valid: true},
		})
	} else {
