// List godoc
// @Summary List {{.R.HumanPlural}}
// @Description Cursor-paginated, newest first.
// @Tags {{.M.Pascal}}
// @Produce json
// @Security BearerAuth
// @Security ApiKeyAuth
// @Param limit query int false "Max items to return" default(20)
// @Param startingAfter query string false "nextCursor of the previous page"
// @Success 200 {object} response.ListResponse{data=[]{{.M.Ident}}dto.{{.R.Pascal}}Response}
// @Failure 400 {object} apperror.ProblemDetails
// @Failure 401 {object} apperror.ProblemDetails
// @Failure 403 {object} apperror.ProblemDetails
// @Router /{{.M.Route}}/{{.R.PluralRoute}} [get]
func (h *{{.R.Pascal}}Handler) List(c fiber.Ctx) error {
	limit, startingAfter, err := httpx.CursorQuery(c)
	if err != nil {
		return err
	}
	page, err := h.service.List(c.Context(), limit, startingAfter)
	if err != nil {
		return err
	}
	items := make([]{{.M.Ident}}dto.{{.R.Pascal}}Response, len(page.Items))
	for i, item := range page.Items {
		items[i] = to{{.R.Pascal}}Response(item)
	}
	return response.List(c, items, page.HasMore, page.NextCursor)
}

