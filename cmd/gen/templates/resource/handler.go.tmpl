// List returns a cursor page, newest first.
func (h *{{.R.Pascal}}Handler) List(ctx context.Context, in *List{{.R.PluralPascal}}Input) (*httpapi.ListOutput[{{.M.Ident}}dto.{{.R.Pascal}}Response], error) {
	page, err := h.service.List(ctx, in.Limit, in.StartingAfter)
	if err != nil {
		return nil, err
	}
	items := make([]{{.M.Ident}}dto.{{.R.Pascal}}Response, len(page.Items))
	for i, item := range page.Items {
		items[i] = to{{.R.Pascal}}Response(item)
	}
	return &httpapi.ListOutput[{{.M.Ident}}dto.{{.R.Pascal}}Response]{
		Body: pagination.NewList("/api/v1/{{.M.Route}}/{{.R.PluralRoute}}", items, page.HasMore, page.NextCursor),
	}, nil
}

// Patch applies an RFC 7396 merge patch. If-Match is a precondition enforced
// by the UPDATE itself, so two writers holding the same ETag cannot both win.
func (h *{{.R.Pascal}}Handler) Patch(ctx context.Context, in *Patch{{.R.Pascal}}Input) (*httpapi.ETagOutput[{{.M.Ident}}dto.{{.R.Pascal}}Response], error) {
	current, err := h.service.Get(ctx, in.ID)
	if err != nil {
		return nil, err
	}
	currentETag := {{.R.Camel}}ETag(current.UpdatedAt)
	if err := httpapi.CheckIfMatchValue(in.IfMatch, currentETag); err != nil {
		return nil, err
	}
	var expected *time.Time
	if in.IfMatch != "" {
		value := current.UpdatedAt
		expected = &value
	}
	updated, err := h.service.Patch(ctx, in.ID, {{.M.Ident}}service.{{.R.Pascal}}Patch{Name: in.Body.Name}, expected)
	if err != nil {
		return nil, err
	}
	return &httpapi.ETagOutput[{{.M.Ident}}dto.{{.R.Pascal}}Response]{
		ETag: {{.R.Camel}}ETag(updated.UpdatedAt),
		Body: to{{.R.Pascal}}Response(updated),
	}, nil
}

// Delete removes one {{.R.Human}}.
func (h *{{.R.Pascal}}Handler) Delete(ctx context.Context, in *{{.R.Pascal}}IDInput) (*httpapi.Empty, error) {
	if err := h.service.Delete(ctx, in.ID); err != nil {
		return nil, err
	}
	return &httpapi.Empty{}, nil
}

func to{{.R.Pascal}}Response(item {{.M.Ident}}service.{{.R.Pascal}}) {{.M.Ident}}dto.{{.R.Pascal}}Response {
	return {{.M.Ident}}dto.{{.R.Pascal}}Response{
		ID:        item.ID,
		Name:      item.Name,
		CreatedAt: item.CreatedAt,
		UpdatedAt: item.UpdatedAt,
	}
}

// {{.R.Camel}}ETag derives the strong validator from the exact column the
// conditional UPDATE compares against.
func {{.R.Camel}}ETag(updatedAt time.Time) string {
	if updatedAt.IsZero() {
		return ""
	}
	return `"` + strconv.FormatInt(updatedAt.UTC().UnixNano(), 10) + `v"`
}
