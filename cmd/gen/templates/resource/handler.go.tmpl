// Get returns one {{.R.Human}} with its ETag.
func (h *{{.R.Pascal}}Handler) Get(ctx context.Context, in *{{.R.Pascal}}IDInput) (*httpapi.ETagOutput[{{.M.Ident}}dto.{{.R.Pascal}}Response], error) {
	found, err := h.service.Get(ctx, in.ID)
	if err != nil {
