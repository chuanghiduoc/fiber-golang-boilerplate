// Create stores a new {{.R.Human}}.
func (h *{{.R.Pascal}}Handler) Create(ctx context.Context, in *Create{{.R.Pascal}}Input) (*httpapi.Created[{{.M.Ident}}dto.{{.R.Pascal}}Response], error) {
	created, err := h.service.Create(ctx, {{.M.Ident}}service.{{.R.Pascal}}Input{Name: in.Body.Name})
