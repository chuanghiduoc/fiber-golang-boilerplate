func Test{{.R.Pascal}}Handler(t *testing.T) {
	fake := &fake{{.R.Pascal}}UseCases{}
	h := New{{.R.Pascal}}Handler(fake)
	app := newTestApp()
	app.Post("/{{.R.PluralRoute}}", h.Create)
	app.Get("/{{.R.PluralRoute}}", h.List)
	app.Get("/{{.R.PluralRoute}}/:id", h.Get)
	app.Put("/{{.R.PluralRoute}}/:id", h.Update)
	app.Delete("/{{.R.PluralRoute}}/:id", h.Delete)

	if status, body := do(t, app, http.MethodPost, "/{{.R.PluralRoute}}", `{"name":"fixture"}`); status != http.StatusCreated || !strings.Contains(body, `"id":7`) {
		t.Fatalf("POST = %d %s, want 201", status, body)
	}
	if fake.lastInput.Name != "fixture" {
		t.Fatalf("Create input = %+v", fake.lastInput)
	}
	if status, body := do(t, app, http.MethodGet, "/{{.R.PluralRoute}}?limit=5&startingAfter=abc", ""); status != http.StatusOK ||
		!strings.Contains(body, `"hasMore":true`) || !strings.Contains(body, `"nextCursor":"next"`) {
		t.Fatalf("GET list = %d %s", status, body)
	}
	if fake.lastLimit != 5 || fake.lastCursor != "abc" {
		t.Fatalf("List got limit=%d cursor=%q", fake.lastLimit, fake.lastCursor)
	}
	if status, body := do(t, app, http.MethodGet, "/{{.R.PluralRoute}}/7", ""); status != http.StatusOK || !strings.Contains(body, `"name":"fixture"`) {
		t.Fatalf("GET = %d %s", status, body)
	}
	if status, body := do(t, app, http.MethodGet, "/{{.R.PluralRoute}}/404", ""); status != http.StatusNotFound || !strings.Contains(body, string({{.M.Ident}}catalog.Code{{.R.Pascal}}NotFound)) {
		t.Fatalf("GET missing = %d %s, want 404 %s", status, body, {{.M.Ident}}catalog.Code{{.R.Pascal}}NotFound)
	}
	if status, body := do(t, app, http.MethodPut, "/{{.R.PluralRoute}}/7", `{"name":"renamed"}`); status != http.StatusOK || fake.lastInput.Name != "renamed" {
		t.Fatalf("PUT = %d %s", status, body)
	}
	if status, body := do(t, app, http.MethodDelete, "/{{.R.PluralRoute}}/7", ""); status != http.StatusNoContent || fake.deletedID != 7 {
		t.Fatalf("DELETE = %d %s", status, body)
	}
}

func Test{{.R.Pascal}}HandlerRejectsBadInput(t *testing.T) {
	h := New{{.R.Pascal}}Handler(&fake{{.R.Pascal}}UseCases{})
	app := newTestApp()
	app.Post("/{{.R.PluralRoute}}", h.Create)
	app.Get("/{{.R.PluralRoute}}/:id", h.Get)

	cases := map[string]struct {
		method, target, body string
		want                 int
	}{
		"missing body":  {http.MethodPost, "/{{.R.PluralRoute}}", "", http.StatusBadRequest},
		"unknown field": {http.MethodPost, "/{{.R.PluralRoute}}", `{"name":"x","extra":1}`, http.StatusBadRequest},
		"empty name":    {http.MethodPost, "/{{.R.PluralRoute}}", `{"name":""}`, http.StatusUnprocessableEntity},
		"bad id":        {http.MethodGet, "/{{.R.PluralRoute}}/abc", "", http.StatusBadRequest},
	}
	for name, tc := range cases {
		if status, body := do(t, app, tc.method, tc.target, tc.body); status != tc.want {
			t.Errorf("%s: %s %s = %d %s, want %d", name, tc.method, tc.target, status, body, tc.want)
		}
	}
}
