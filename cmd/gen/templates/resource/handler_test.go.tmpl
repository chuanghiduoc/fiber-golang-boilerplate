	}
	if _, err := h.Delete(context.Background(), &{{.R.Pascal}}IDInput{ID: fixtureID}); err != nil || fake.deletedID != fixtureID {
		t.Fatalf("Delete = %v id=%s", err, fake.deletedID)
	}
}

