}

func (f *fake{{.R.Pascal}}UseCases) Create(_ context.Context, in {{.M.Ident}}service.{{.R.Pascal}}Input) ({{.M.Ident}}service.{{.R.Pascal}}, error) {
	f.lastInput = in
