	patched, err := h.Patch(context.Background(), &Patch{{.R.Pascal}}Input{
		ID: fixtureID, IfMatch: got.ETag,
		Body: {{.M.Ident}}dto.{{.R.Pascal}}PatchRequest{Name: strPtr("renamed")},
	})
	if err != nil || fake.lastPatch.Name == nil || *fake.lastPatch.Name != "renamed" || fake.lastExpected == nil {
		t.Fatalf("Patch = %+v, %v last=%+v", patched, err, fake.lastPatch)
	}
	if _, err := h.Patch(context.Background(), &Patch{{.R.Pascal}}Input{ID: fixtureID, IfMatch: `"stale"`}); err == nil {
		t.Fatal("a stale If-Match must be rejected")
	}
	page, err := h.List(context.Background(), &List{{.R.PluralPascal}}Input{Limit: 5})
	if err != nil || !page.Body.HasMore || page.Body.NextCursor != "next" {
