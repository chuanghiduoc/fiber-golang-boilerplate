-- {{.R.Table}}: tenant-scoped {{.R.HumanPlural}} owned by the {{.M.Name}} module.
CREATE TABLE IF NOT EXISTS {{.R.Table}} (
    id UUID PRIMARY KEY DEFAULT uuidv7(),
    -- tenants is the only cross-module foreign key a module may declare
    --. RESTRICT: a tenant with {{.R.HumanPlural}} cannot be deleted.
    tenant_id UUID NOT NULL REFERENCES tenants (id) ON DELETE RESTRICT,
    name VARCHAR(255) NOT NULL CHECK (btrim(name) <> ''),
    created_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT NOW()
);

-- Serves the tenant-scoped cursor list: WHERE tenant_id = $1 AND
-- (created_at, id) < ($2, $3) ORDER BY created_at DESC, id DESC.
CREATE INDEX IF NOT EXISTS idx_{{.R.Table}}_tenant_created
    ON {{.R.Table}} (tenant_id, created_at DESC, id DESC);

DROP TRIGGER IF EXISTS trigger_{{.R.Table}}_updated_at ON {{.R.Table}};
CREATE TRIGGER trigger_{{.R.Table}}_updated_at
    BEFORE UPDATE ON {{.R.Table}}
    FOR EACH ROW
    EXECUTE FUNCTION update_updated_at();

-- Row-level security is mandatory for every tenant-owned table: the API role
-- is not a superuser, so FORCE makes the policy apply to the table owner too.
-- cmd/migrate verifies this shape on every table with a tenant_id column.
ALTER TABLE {{.R.Table}} ENABLE ROW LEVEL SECURITY;
ALTER TABLE {{.R.Table}} FORCE ROW LEVEL SECURITY;
CREATE POLICY tenant_isolation ON {{.R.Table}}
    USING (app_tenant_visible(tenant_id))
    WITH CHECK (app_tenant_visible(tenant_id));
