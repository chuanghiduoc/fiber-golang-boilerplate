// {{.U.Name}}Input is the input of the {{.U.Name}} {{.U.Kind}}.
type {{.U.Name}}Input struct{}

// {{.U.Name}}Result is the result of the {{.U.Name}} {{.U.Kind}}.
type {{.U.Name}}Result struct{}

// {{.U.Name}}Handler handles the {{.U.Name}} {{.U.Kind}}.{{if .U.IsCommand}} A command changes
// state and returns only what the caller needs to continue.{{else}} A query reads state
// and never changes it.{{end}} Declare what it needs as ports in ports.go and
// take them in New{{.U.Name}}Handler.
type {{.U.Name}}Handler struct {
	authorizer authz.Authorizer
}

// New{{.U.Name}}Handler returns a {{.U.Name}}Handler.
func New{{.U.Name}}Handler(authorizer authz.Authorizer) *{{.U.Name}}Handler {
	return &{{.U.Name}}Handler{authorizer: authorizer}
}

// Handle runs the {{.U.Kind}}. Until its behavior is written it fails with
// {{.M.Ident}}catalog.CodeNotImplemented (501), so an unfinished use case can
// never report success.
func (h *{{.U.Name}}Handler) Handle(ctx context.Context, in {{.U.Name}}Input) ({{.U.Name}}Result, error) {
	if err := authorize(ctx, h.authorizer, {{.M.Ident}}catalog.{{.U.Permission}}); err != nil {
		return {{.U.Name}}Result{}, err
	}
	return {{.U.Name}}Result{}, apperror.NewCode({{.M.Ident}}catalog.CodeNotImplemented, "{{.U.Name}} is not implemented")
}