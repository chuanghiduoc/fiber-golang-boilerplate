package handler

import (
	"context"
	"testing"

	{{.M.Ident}}service "{{.M.ModulePath}}/internal/modules/{{.M.Name}}/service"
)

type fake{{.U.Name}} struct{ calls int }

func (f *fake{{.U.Name}}) Handle(context.Context, {{.M.Ident}}service.{{.U.Name}}Input) ({{.M.Ident}}service.{{.U.Name}}Result, error) {
	f.calls++
	return {{.M.Ident}}service.{{.U.Name}}Result{}, nil
}

func Test{{.U.Name}}HTTP(t *testing.T) {
	fake := &fake{{.U.Name}}{}
{{- if .U.IsCommand}}
	out, err := New{{.U.Name}}HTTP(fake).Handle(context.Background(), &{{.U.Camel}}Input{})
{{- else}}
	out, err := New{{.U.Name}}HTTP(fake).Handle(context.Background(), &struct{}{})
{{- end}}
	if err != nil || out == nil || fake.calls != 1 {
		t.Fatalf("Handle = %v, %v (calls=%d), want one result", out, err, fake.calls)
	}
}
