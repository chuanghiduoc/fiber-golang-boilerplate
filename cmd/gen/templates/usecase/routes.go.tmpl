package {{.M.Name}}

import (
	"net/http"

	{{.M.Ident}}catalog "{{.M.ModulePath}}/internal/modules/{{.M.Name}}/catalog"
	"{{.M.ModulePath}}/internal/platform/httpapi"
)

{{if .U.IsCommand -}}
// register{{.U.Name}}Route declares the {{.U.Name}} command. It is a Tier 2
// audited mutation: idempotency first, then a required intent row.
func (m *Module) register{{.U.Name}}Route(api *httpapi.API) {
	httpapi.Register(api, httpapi.Op{
		Method:      http.MethodPost,
		Path:        "/api/v1/{{.M.Route}}/{{.U.Route}}",
		OperationID: "{{.U.Camel}}",
		Tags:        []string{"{{.M.Route}}"},
		Summary:     "{{.U.Human}}",
	}, httpapi.Policy{
		Permission: {{.M.Ident}}catalog.{{.U.Permission}},
		RateLimit:  httpapi.RateLimitNormal,
		Idempotent: true,
		Audit: httpapi.AuditPolicy{Guard: &httpapi.GuardPolicy{
			Action: "{{.M.Name}}.{{.U.Snake}}", Resource: "{{.M.Name}}",
		}},
	}, m.handlers.{{.U.Name}}.Handle)
}
{{- else -}}
// register{{.U.Name}}Route declares the {{.U.Name}} query.
func (m *Module) register{{.U.Name}}Route(api *httpapi.API) {
	httpapi.Register(api, httpapi.Op{
		Method:      http.MethodGet,
		Path:        "/api/v1/{{.M.Route}}/{{.U.Route}}",
		OperationID: "{{.U.Camel}}",
		Tags:        []string{"{{.M.Route}}"},
		Summary:     "{{.U.Human}}",
	}, httpapi.Policy{
		Permission: {{.M.Ident}}catalog.{{.U.Permission}},
		RateLimit:  httpapi.RateLimitRelaxed,
	}, m.handlers.{{.U.Name}}.Handle)
}
{{- end}}
